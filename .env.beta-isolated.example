# Create .env.beta-isolated from scratch in the isolated beta project only.
# Never source/copy .env.oci. Empty values intentionally fail Compose validation.
COMMIT_SHA=
BETA_SECRET_KEY=
BETA_DB_PASSWORD=
BETA_DB_ROOT_PASSWORD=
# Generate independent random values; do not use production credentials.
# Escape literal dollars as $$ when consumed by Compose.
