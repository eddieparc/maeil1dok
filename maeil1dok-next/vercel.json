{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "crons": [
    {
      "path": "/api/cron/hasena-summary",
      "schedule": "0 0-1 * * 1-6"
    },
    {
      "path": "/api/cron/hasena-summary",
      "schedule": "*/30 1-6 * * 1-6"
    }
  ]
}
