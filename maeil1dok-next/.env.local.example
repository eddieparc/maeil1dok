# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth (Supabase handles these server-side, documented here for reference)
# Configure these in Supabase Dashboard > Authentication > Providers
# SUPABASE_AUTH_KAKAO_CLIENT_ID=your-kakao-client-id
# SUPABASE_AUTH_KAKAO_SECRET=your-kakao-secret
# SUPABASE_AUTH_GOOGLE_CLIENT_ID=your-google-client-id
# SUPABASE_AUTH_GOOGLE_SECRET=your-google-secret
# SUPABASE_AUTH_APPLE_CLIENT_ID=your-apple-client-id
# SUPABASE_AUTH_APPLE_SECRET=your-apple-secret

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Cron
CRON_SECRET=your_cron_secret_here

# YouTube / Hasena
HASENA_PLAYLIST_ID=your_youtube_playlist_id_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# Firebase (FCM Push Notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
