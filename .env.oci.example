# maeil1dok OCI 프로덕션 환경변수 — cp .env.oci.example .env.oci 후 채워서 사용.
# docker-compose.oci.yml 이 env_file 로 로드. 실제 값은 `railway variables` 덤프에서 이관.
# DB_HOST/DB_PORT/REDIS_URL/CELERY_* 는 compose 가 주입하므로 여기 없어도 됨.

# ── OCI 데이터 경로 (VM 로컬 디스크) ──────────────────────────────────
OCI_DATA_ROOT=/mnt/data/maeil1dok

# ── Django 핵심 ────────────────────────────────────────────────────────
# SECRET_KEY 는 Railway 와 동일하게 유지(세션/JWT 서명 호환).
SECRET_KEY=
DEBUG=False

# ── 데이터베이스 (자체 호스팅 MySQL 8 컨테이너) ────────────────────────
# DB_HOST=mysql / DB_PORT=3306 은 compose 가 주입.
DB_NAME=maeil1dok
DB_USER=maeil1dok
DB_PASSWORD=            # 강력한 비밀번호 필수
DB_ROOT_PASSWORD=      # mysql root 비밀번호(백업/관리용)

# ── 호스트 / CORS / CSRF ───────────────────────────────────────────────
# 백엔드는 api.maeil1dok.app 로 서빙 → ALLOWED_HOSTS 에 반드시 포함.
ALLOWED_HOSTS=api.maeil1dok.app,maeil1dok.app,www.maeil1dok.app
# 아래 두 값은 JSON 배열 문자열(기본 프로덕션 origin 에 추가됨).
CORS_ALLOWED_ORIGINS=["https://maeil1dok.app","https://www.maeil1dok.app"]
CSRF_TRUSTED_ORIGINS=["https://maeil1dok.app","https://www.maeil1dok.app","https://api.maeil1dok.app"]
# 쿠키 도메인(기본 .maeil1dok.app). 명시 유지 권장.
COOKIE_DOMAIN=.maeil1dok.app
COOKIE_SAMESITE=Lax
# nginx :443 이 실 TLS 종단 → X-Forwarded-Proto=https 로 Django 가 https 인지(리다이렉트 루프 방지).
SECURE_SSL_REDIRECT=True
FRONTEND_URL=https://maeil1dok.app

# ── 소셜 로그인 (콜백 = 프론트엔드 URL, Railway 와 정확히 동일하게 유지; 호스트 변경 금지) ──
# 콜백은 프론트(maeil1dok.app/auth/*)가 받아 백엔드로 code 전달. 백엔드는 token 교환에 이 값 사용.
# Kakao/Google 콘솔 등록값과도 일치해야 하므로 절대 바꾸지 말 것.
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=https://maeil1dok.app/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://maeil1dok.app/auth/google/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── 외부 API ───────────────────────────────────────────────────────────
API_BIBLE_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# ── 웹 푸시 (VAPID) ────────────────────────────────────────────────────
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@maeil1dok.app

# ── 크론/하세나 시크릿 ─────────────────────────────────────────────────
CRON_SECRET=

# ── 이메일 (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@maeil1dok.app
FROM_NAME=매일일독

# ── 관측성 (Sentry) ────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ── Celery 튜닝 (선택) ─────────────────────────────────────────────────
CELERY_WORKER_CONCURRENCY=2

# ── Cloudflare Tunnel (api.maeil1dok.app 라우팅; urban-blanks 무접촉) ──────
# CF 대시보드/API로 터널 생성 후 토큰 주입. 퍼블릭 호스트명 api.maeil1dok.app → http://web:8000 은 CF 원격 관리.
CF_TUNNEL_TOKEN=
