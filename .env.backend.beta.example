# Fresh .env.backend.beta: reviewed beta OAuth clients only, no production env copy.
# API clients may be separately approved provider registrations; provider consoles
# must allow the beta callback URLs fixed by docker-compose.beta-isolated.yml.
KAKAO_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# No Resend/AI/YouTube/cron/push/Sentry credentials. Mail uses a private test spool.
# An optional independent Bible provider key can be reviewed before enabling it.
API_BIBLE_KEY=
