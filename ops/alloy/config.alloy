logging {
  level  = "warn"
  format = "logfmt"
}

discovery.docker "maeil1dok" {
  host = "tcp://docker-proxy:2375"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=maeil1dok"]
  }
}

discovery.relabel "maeil1dok" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "maeil1dok" {
  host             = "tcp://docker-proxy:2375"
  targets          = discovery.docker.maeil1dok.targets
  relabel_rules    = discovery.relabel.maeil1dok.rules
  refresh_interval = "5s"
  forward_to       = [loki.process.maeil1dok.receiver]
}

loki.process "maeil1dok" {
  stage.json {
    expressions = {
      level      = "level",
      logger     = "logger",
      request_id = "request_id",
      trace_id   = "trace_id",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.structured_metadata {
    values = {
      logger     = "",
      request_id = "",
      trace_id   = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
